#!/usr/bin/expect -f

# Grab machine from env
set MACHINE qemuarm
catch {set MACHINE $env(MACHINE)}

set script_dir [file dirname [file normalize $::argv0]]

spawn bash -c "cd $script_dir && source sources/poky/oe-init-build-env builds/build-${MACHINE} && runqemu ${MACHINE} nographic"

set timeout 180

expect {
    -re ".*login: " {
        send "root\r"
    }
    timeout {
        puts "ERROR: Login prompt not received"
        exit 1
    }
}

expect {
    -re {root@.*# } {
        # got shell prompt after login
    }
    timeout {
        puts "ERROR: Timeout waiting for root shell prompt after login"
        exit 1
    }
}

send "hello-world; echo __RET:$?__\r"

expect {
    -re {__RET:([0-9]+)__} {
        set ret $expect_out(1,string)
        puts "hello-world exit code: $ret"
        exit $ret
    }
    timeout {
        puts "ERROR: Timeout waiting for return code"
        exit 1
    }
}

